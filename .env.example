# Copy to .env (never commit .env). All REACT_APP_* values are embedded in the public JavaScript bundle.

# --- Movie metadata (TMDB) ---------------------------------------------------
# TMDB v3 API key. Anything shipped to a browser can be read by visitors; to keep the key private,
# leave this empty and set REACT_APP_TMDB_BASE_URL to a small proxy that adds the key server-side.
REACT_APP_API_KEY=54e967ea0a74ee452e62bf6fe1549180
# Optional: proxy base URL (no trailing slash), e.g. https://tmdb-proxy.example.com/3
REACT_APP_TMDB_BASE_URL=

# --- Playback (authorized full-length sources) ---------------------------------
# JSON catalogue of titles you are allowed to stream. Default: /catalog.json served from public/.
REACT_APP_PLAYBACK_CATALOG_URL=
# Optional: your own server returning a (signed) source per title: GET {url}/{tmdbId}
REACT_APP_PLAYBACK_RESOLVER_URL=

# --- Site ----------------------------------------------------------------------
# Public origin (+ path) used for canonical URLs, social cards and sitemap.xml
REACT_APP_SITE_URL=
